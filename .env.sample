# App
APP_NAME=hrcore-system
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# Spring datasource
DB_HOST=serv-hrcore-db
DB_HOST_PORT=55432

DB_NAME=hrcore_db
DB_PORT=5432
DB_USER=hrcore_user
DB_PASSWORD=hrcore_password

# Backup CLI tools and storage
BACKUP_LOCAL_PATH=/storage/backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql

# JWT
JWT_SECRET=change-this-secret-key-with-at-least-32-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Multitenancy
TENANT_HEADER_NAME=X-Tenant-Slug
PUBLIC_SCHEMA=public

# Seed Database
APP_BOOTSTRAP_SAMPLE_DATA_ENABLED=True

# CORS
CORS_ALLOWED_ORIGINS=https://localhost:443,http://localhost:443,http://localhost:80,http://localhost,http://localhost:4200,http://localhost:8080,http://localhost:5200

# Frontend
FRONTEND_PORT=4200

# Inicial superadmin
PLATFORM_SUPERADMIN_EMAIL=superadmin@hrcore.local
PLATFORM_SUPERADMIN_PASSWORD=SuperAdmin123!
PLATFORM_SUPERADMIN_FIRST_NAME=Platform
PLATFORM_SUPERADMIN_LAST_NAME=Admin

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mi-correo@gmail.com
MAIL_PASSWORD=mi-password-smtp
MAIL_FROM=mi-correo@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Backend URLs
API_BASE_URL=http://localhost:8080

# Frontend URLs
FRONTEND_URL_BASE=http://localhost:4200
PASSWORD_RESET_URL_PATH=/reset-password
EMAIL_VERIFICATION_URL_PATH=/verify-email

# Password reset / email verification
PASSWORD_RESET_EXPIRATION_MINUTES=30
EMAIL_VERIFICATION_EXPIRATION_MINUTES=1440

# Face++ (Face recognition)
FACEPP_API_KEY=
FACEPP_API_SECRET=

# Tamaño maximo de archivos (fotos)
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=2MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# Stripe billing
STRIPE_SECRET_KEY=sk_test_51RcaQkEI7XEzyewpl...*
STRIPE_PUBLIC_KEY=pk_test_51RcaQkEI7XEzyewp40...*
STRIPE_WEBHOOK_SECRET=whsec_fe9de9beda2d084c3...*
STRIPE_SUCCESS_URL=http://localhost:4200/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:4200/billing/cancel
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:4200/settings/billing
STRIPE_DEFAULT_CURRENCY=USD
BASIC_MONTHLY_AMOUNT=9.99
BASIC_YEARLY_AMOUNT=99.99
PRO_MONTHLY_AMOUNT=19.99
PRO_YEARLY_AMOUNT=199.99
