FROM node:24-bookworm

WORKDIR /app

EXPOSE 4200

CMD ["sh", "-c", "node -e 'const fs=require(\"fs\"); const e=process.env; const c={apiKey:e.FIREBASE_WEB_API_KEY||\"\",authDomain:e.FIREBASE_WEB_AUTH_DOMAIN||\"\",projectId:e.FIREBASE_WEB_PROJECT_ID||\"\",storageBucket:e.FIREBASE_WEB_STORAGE_BUCKET||\"\",messagingSenderId:e.FIREBASE_WEB_MESSAGING_SENDER_ID||\"\",appId:e.FIREBASE_WEB_APP_ID||\"\",measurementId:e.FIREBASE_WEB_MEASUREMENT_ID||\"\",vapidKey:e.FIREBASE_WEB_VAPID_KEY||\"\"}; fs.writeFileSync(\"public/runtime-config.js\",\"window.__HRCORE_RUNTIME_CONFIG__=\"+JSON.stringify({firebaseWeb:c})+\";\");' && npm install && npm start"]



