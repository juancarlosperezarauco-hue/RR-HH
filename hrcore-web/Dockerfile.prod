FROM node:24-bookworm AS builder

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

ARG FIREBASE_WEB_API_KEY
ARG FIREBASE_WEB_AUTH_DOMAIN
ARG FIREBASE_WEB_PROJECT_ID
ARG FIREBASE_WEB_STORAGE_BUCKET
ARG FIREBASE_WEB_MESSAGING_SENDER_ID
ARG FIREBASE_WEB_APP_ID
ARG FIREBASE_WEB_MEASUREMENT_ID
ARG FIREBASE_WEB_VAPID_KEY

RUN node -e 'const fs=require("fs"); const e=process.env; const c={apiKey:e.FIREBASE_WEB_API_KEY||"",authDomain:e.FIREBASE_WEB_AUTH_DOMAIN||"",projectId:e.FIREBASE_WEB_PROJECT_ID||"",storageBucket:e.FIREBASE_WEB_STORAGE_BUCKET||"",messagingSenderId:e.FIREBASE_WEB_MESSAGING_SENDER_ID||"",appId:e.FIREBASE_WEB_APP_ID||"",measurementId:e.FIREBASE_WEB_MEASUREMENT_ID||"",vapidKey:e.FIREBASE_WEB_VAPID_KEY||""}; fs.writeFileSync("public/runtime-config.js","window.__HRCORE_RUNTIME_CONFIG__="+JSON.stringify({firebaseWeb:c})+";");'

RUN npm run build


FROM nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder \
  /app/dist/hrcore-web/browser \
  /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
